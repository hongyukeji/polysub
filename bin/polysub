#!/bin/bash
# PolySub：视频 → 目标语言字幕（本机语音识别 + 本机或云端大模型翻译）
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
[ -f "$ROOT/config.sh" ] && source "$ROOT/config.sh"
source "$ROOT/config.example.sh"   # 只补默认值，不覆盖已设置的
PY="$ROOT/.venv/bin/python"

usage() {
  cat <<EOF
用法: polysub [选项] <视频>

  -t, --to LANG        字幕语言，默认 $POLYSUB_TO（zh-Hans zh-Hant en ja ko fr de es ...）
  -f, --from LANG      视频原语言，默认 $POLYSUB_FROM（auto = 自动识别）
  -p, --provider NAME  翻译模型：local | deepseek | qwen，默认 $POLYSUB_PROVIDER
      --think LEVEL    翻译思考档位：off | low | medium，默认 $POLYSUB_THINK
  -o, --output PATH    输出文件，默认 <视频名>.<LANG>.srt（放在视频旁边）
      --keep-work      保留中间文件（识别原文、翻译参考），打印其目录
  -h, --help           显示本帮助

配置文件: $ROOT/config.sh（模板见 config.example.sh）
EOF
}

OUT=""; KEEP=0; VIDEO=""
while [ $# -gt 0 ]; do
  case "$1" in
    -t|--to) POLYSUB_TO="$2"; shift 2;;
    -f|--from) POLYSUB_FROM="$2"; shift 2;;
    -p|--provider) POLYSUB_PROVIDER="$2"; shift 2;;
    --think) POLYSUB_THINK="$2"; shift 2;;
    -o|--output) OUT="$2"; shift 2;;
    --keep-work) KEEP=1; shift;;
    -h|--help) usage; exit 0;;
    -*) echo "未知选项: $1" >&2; usage >&2; exit 2;;
    *) VIDEO="$1"; shift;;
  esac
done
[ -n "$VIDEO" ] || { usage >&2; exit 2; }
[ -f "$VIDEO" ] || { echo "找不到视频: $VIDEO" >&2; exit 2; }
[ -x "$PY" ] || { echo "还没安装依赖，先运行: $ROOT/install.sh" >&2; exit 2; }
OUT="${OUT:-${VIDEO%.*}.$POLYSUB_TO.srt}"

# ---- 翻译模型（provider） ----
FB_ARGS=()
case "$POLYSUB_PROVIDER" in
  local)    UP="$POLYSUB_OMLX"; KEY="$POLYSUB_OMLX_KEY"; MODEL="$POLYSUB_LOCAL_MODEL"; STYLE=local; THREADS=1;;
  deepseek) UP="$POLYSUB_DEEPSEEK_BASE"; KEY="$DEEPSEEK_API_KEY"; MODEL="$POLYSUB_DEEPSEEK_MODEL"; STYLE=deepseek; THREADS=4;;
  qwen)     UP="$POLYSUB_QWEN_BASE"; KEY="$DASHSCOPE_API_KEY"; MODEL="$POLYSUB_QWEN_MODEL"; STYLE=qwen; THREADS=4;;
  *) echo "未知 provider: $POLYSUB_PROVIDER（可选 local / deepseek / qwen）" >&2; exit 2;;
esac
if [ "$POLYSUB_PROVIDER" != local ]; then
  [ -n "$KEY" ] || { echo "provider=$POLYSUB_PROVIDER 需要 API Key，写到 $ROOT/config.sh" >&2; exit 2; }
  [ "$POLYSUB_FALLBACK_LOCAL" = 1 ] && FB_ARGS=(LP_FB_UPSTREAM="$POLYSUB_OMLX" LP_FB_KEY="$POLYSUB_OMLX_KEY" LP_FB_MODEL="$POLYSUB_LOCAL_MODEL")
fi

WORK="$(mktemp -d "${TMPDIR:-/tmp}/polysub.XXXXXX")"
PIDS=()
cleanup() {
  for p in "${PIDS[@]:-}"; do [ -n "$p" ] && kill "$p" 2>/dev/null; done
  if [ "$KEEP" = 1 ]; then echo "中间文件保留在: $WORK"; else rm -rf "$WORK"; fi
}
trap cleanup EXIT
log() { printf '[%s] %s\n' "$(date +%T)" "$*"; }
free_port() { "$PY" -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])'; }

# 两个本地转发：一个给翻译（按 --think），一个给翻译参考（固定 low：比 medium 快约 2.5 倍，off 会编造）
start_relay() {  # $1=port $2=think
  env LP_PORT="$1" LP_UPSTREAM="$UP" LP_KEY="$KEY" LP_MODEL="$MODEL" LP_STYLE="$STYLE" \
      LP_THINK="$2" LP_STATS="$WORK/fallback.log" ${FB_ARGS[@]+"${FB_ARGS[@]}"} \
      "$PY" "$ROOT/lib/llm_proxy.py" 2>>"$WORK/relay.log" &
  PIDS+=($!); disown
}
TPORT=$(free_port); start_relay "$TPORT" "$POLYSUB_THINK"
NPORT=$(free_port); start_relay "$NPORT" low
sleep 0.5

export POLYSUB_OMLX POLYSUB_OMLX_KEY
ASR=("$PY" "$ROOT/lib/asr_vad.py" --model "$POLYSUB_ASR_MODEL" --lang "$POLYSUB_FROM" --threshold 0.25 --max-speech 8)

log "PolySub: $(basename "$VIDEO") | $POLYSUB_FROM → $POLYSUB_TO | 翻译: $POLYSUB_PROVIDER/$MODEL（思考 $POLYSUB_THINK）"
log "1/5 抽取 16kHz 单声道音轨"
ffmpeg -v error -y -i "$VIDEO" -vn -ac 1 -ar 16000 -c:a pcm_s16le "$WORK/audio.wav"

log "2/5 第一遍识别（VAD + $POLYSUB_ASR_MODEL）"
"${ASR[@]}" "$WORK/audio.wav" "$WORK/asr1.srt"

log "3/5 通读全片，生成翻译参考与识别提示词"
POLYSUB_NOTE_API="http://127.0.0.1:$NPORT" "$PY" "$ROOT/lib/context_note.py" "$WORK/asr1.srt" "$WORK/brief.txt" "$POLYSUB_TO"
TERMS="$(cat "$WORK/brief.txt.terms")"

log "4/5 第二遍识别（提示词：${TERMS:-无}）"
"${ASR[@]}" --prompt "$TERMS" "$WORK/audio.wav" "$WORK/asr2.srt"

log "5/5 断句 + 翻译为 $POLYSUB_TO"
# VideoCaptioner 的 LLM 缓存不区分思考档位和 provider，清掉避免拿到旧结果
rm -rf "$HOME/Library/Application Support/videocaptioner/cache"
"$PY" -m videocaptioner.cli subtitle "$WORK/asr2.srt" \
  --api-base "http://127.0.0.1:$TPORT/v1" --api-key polysub --model "$MODEL" \
  --translator llm --target-language "$POLYSUB_TO" --layout target-only \
  --no-optimize --thread-num "$THREADS" --prompt "$(cat "$WORK/brief.txt")" -o "$OUT"

# 关思考时模型偶尔原样保留日文汉字（人名、称呼）；统一成目标写法
case "$POLYSUB_TO" in
  zh-Hans|zh-CN|zh) CC=t2s;;
  zh-Hant|zh-TW) CC=s2tw;;
  *) CC="";;
esac
[ -n "$CC" ] && "$PY" -c 'import sys; from opencc import OpenCC; p=sys.argv[1]; t=open(p, encoding="utf-8").read(); open(p, "w", encoding="utf-8").write(OpenCC(sys.argv[2]).convert(t))' "$OUT" "$CC"

if [ -s "$WORK/fallback.log" ]; then
  log "注意：有 $(wc -l < "$WORK/fallback.log" | tr -d ' ') 批被云端拒绝，已改用本机模型翻译"
fi
log "完成 -> $OUT"
